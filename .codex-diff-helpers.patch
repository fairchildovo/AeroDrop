+const findAttemptForCommit = (
+  session: ReceiverSessionRecord | undefined,
+  attemptId: string,
+  connectionId: string
+): RegisterAttemptInput | null => {
+  if (!session) {
+    return null;
+  }
+
+  const attempts = [session.attempts.all, session.attempts.relay];
+  const matched = attempts.find(
+    (attempt) => attempt?.attemptId === attemptId && attempt.connectionId === connectionId
+  );
+
+  return matched ? cloneAttempt(matched) : null;
+};
