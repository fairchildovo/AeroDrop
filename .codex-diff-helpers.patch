+  status: 'accepted' | 'duplicate' | 'conflict';
+  committedConnectionId: string;
+};
+
 export const createRouteCommitGate = () => {
   const committed = new Map<string, string>();
 
   return {
     // Commit gate owns metadata-send gating after the winner has been decided.
+    claimCommit(receiverSessionId: string, connectionId: string): CommitClaimResult {
+      const existing = committed.get(receiverSessionId);
+      if (!existing) {
+        committed.set(receiverSessionId, connectionId);
+        return {
+          status: 'accepted',
+          committedConnectionId: connectionId,
+        };
+      }
+
+      if (existing === connectionId) {
+        return {
+          status: 'duplicate',
+          committedConnectionId: existing,
+        };
+      }
+
+      return {
+        status: 'conflict',
+        committedConnectionId: existing,
+      };
