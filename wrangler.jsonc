{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aerodrop",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-04-06",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "TURN_URLS": "turn:turn.tianzora.uno:3478?transport=tcp,turns:turn.tianzora.uno:5349?transport=tcp",
    "TURN_REALM": "turn.tianzora.uno",
    "TURN_TTL_SECONDS": "3600"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING_HUB",
        "class_name": "SignalingHub"
      }
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "migrations": [
    {
      "tag": "v1-signaling-hub",
      "new_sqlite_classes": [
        "SignalingHub"
      ]
    }
  ]
}
