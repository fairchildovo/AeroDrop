{
  "name": "aerodrop",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.8.2",
  "type": "module",
  "engines": {
    "node": "22.12.0",
    "npm": "10.8.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --config wrangler.jsonc",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --config wrangler.jsonc",
    "preview:e2e": "vite build && vite preview --host 127.0.0.1 --port 3401 --strictPort",
    "test:receive": "node ./scripts/run-node-tests.mjs services/receive",
    "test:send": "node ./scripts/run-node-tests.mjs services/send",
    "test:services": "node ./scripts/run-node-tests.mjs services",
    "test:e2e": "start-server-and-test preview:e2e http://127.0.0.1:3401 test:e2e:raw",
    "test:e2e:raw": "playwright test --project=chromium",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "deploy:worker": "npm run deploy"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.26",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "streamsaver": "^2.0.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.0",
    "@cloudflare/workers-types": "^4.20260131.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/streamsaver": "^2.0.5",
    "@vitejs/plugin-react": "^5.0.0",
    "start-server-and-test": "^2.1.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.80.0"
  }
}
